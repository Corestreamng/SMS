# Database Configuration
DB_HOST=localhost
DB_NAME=sms_db
DB_USER=root
DB_PASS=

# Application Configuration
APP_URL=http://localhost
APP_ENV=development

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@sms.com
MAIL_FROM_NAME="School Management System"

# SMS Configuration
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Security
SESSION_LIFETIME=7200
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900
